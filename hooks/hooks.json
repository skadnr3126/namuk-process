{
  "hooks": {
    "UserPromptSubmit": [{
      "hooks": [{
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/hooks/inject-skill.cjs\"",
        "commandWindows": "powershell.exe -NoProfile -NonInteractive -Command \"& node (Join-Path ([Environment]::GetEnvironmentVariable('PLUGIN_ROOT')) 'hooks/inject-skill.cjs')\"",
        "timeout": 10,
        "additionalContextLimit": 20000
      }]
    }],
    "SubagentStart": [{
      "hooks": [{
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/hooks/inject-skill.cjs\"",
        "commandWindows": "powershell.exe -NoProfile -NonInteractive -Command \"& node (Join-Path ([Environment]::GetEnvironmentVariable('PLUGIN_ROOT')) 'hooks/inject-skill.cjs')\"",
        "timeout": 10,
        "additionalContextLimit": 20000
      }]
    }]
  }
}
