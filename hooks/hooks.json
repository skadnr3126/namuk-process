{
  "hooks": {
    "UserPromptSubmit": [{
      "hooks": [{
        "type": "command",
        "command": "node -e \"require(require('node:path').join(process.env.PLUGIN_ROOT,'hooks/inject-skill.cjs'))\" UserPromptSubmit",
        "timeout": 10,
        "additionalContextLimit": 20000
      }]
    }],
    "SubagentStart": [{
      "hooks": [{
        "type": "command",
        "command": "node -e \"require(require('node:path').join(process.env.PLUGIN_ROOT,'hooks/inject-skill.cjs'))\" SubagentStart",
        "timeout": 10,
        "additionalContextLimit": 20000
      }]
    }]
  }
}
