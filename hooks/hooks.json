{
  "hooks": {
    "UserPromptSubmit": [{
      "hooks": [{
        "type": "command",
        "statusMessage": "Loading request-to-implementation...",
        "command": "node -e \"require(require('node:path').join(process.env.PLUGIN_ROOT,'hooks/UserPromptSubmit.cjs'))\"",
        "timeout": 10,
        "additionalContextLimit": 20000
      }]
    }],
    "SubagentStart": [{
      "hooks": [{
        "type": "command",
        "statusMessage": "Loading codebase-design and boundary-responsibility...",
        "command": "node -e \"require(require('node:path').join(process.env.PLUGIN_ROOT,'hooks/SubagentStart.cjs'))\"",
        "timeout": 10,
        "additionalContextLimit": 20000
      }]
    }],
    "SubagentStop": [{
      "hooks": [{
        "type": "command",
        "statusMessage": "Reviewing codebase-design...",
        "command": "node -e \"require(require('node:path').join(process.env.PLUGIN_ROOT,'hooks/review-codebase.cjs'))\"",
        "timeout": 10
      }]
    }]
  }
}
